generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

enum FulfillmentType {
  PICKUP
  DELIVERY
}

enum OrderStatus {
  CONFIRMED
  PREPARING
  READY
  COMPLETED
  CANCELED
}

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role     @default(USER)
  orders       Order[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Category {
  id        String    @id @default(uuid())
  name      String    @unique
  slug      String    @unique
  products  Product[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Product {
  id          String        @id @default(uuid())
  name        String
  description String?
  flavor      String
  categories  Category[]
  price       Decimal       @db.Decimal(10, 2)
  active      Boolean       @default(true)
  image       ProductImage?
  orderItems  OrderItem[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([flavor])
}

model ProductImage {
  productId String   @id
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  data      Bytes
  mimeType  String
  updatedAt DateTime @updatedAt
}

model Order {
  id              String          @id @default(uuid())
  userId          String
  user            User            @relation(fields: [userId], references: [id])
  status          OrderStatus     @default(CONFIRMED)
  fulfillmentType FulfillmentType
  scheduledDate   DateTime        @db.Date
  total           Decimal         @db.Decimal(10, 2)
  street          String?
  number          String?
  complement      String?
  district        String?
  city            String?
  state           String?
  zipCode         String?
  items           OrderItem[]
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([userId])
}

model OrderItem {
  id        String  @id @default(uuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id])
  quantity  Int
  unitPrice Decimal @db.Decimal(10, 2)
  notes     String?

  @@index([orderId])
}
